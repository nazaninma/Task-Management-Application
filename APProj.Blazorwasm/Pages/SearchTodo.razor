@using System.Collections
@using System.Collections.Generic
@using System.Collections.ObjectModel
@using System.Collections.Specialized
@using System.ComponentModel
@using Microsoft.AspNetCore.SignalR.Client
@using SynchronizedCollection

@page "/SearchTodo"
@inject HttpClient Http

<PageTitle>Search Todo</PageTitle>

<h1>search Todos</h1>

<select @bind=@choice>
    <option value="">Select</option>
    <option value="id">Id</option>
    <option value="name">Name</option>
</select>
<br>
<span><em>Write the @choice </em></span> <input type=text @bind-value=request />

<button class="btn btn-primary" @onclick="Search">search</button>
<br>
<span><em>The error is: @error </em></span>

@if (c == null)
{
    <p><em> @error </em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Task Name</th>
                <th>Task Deadline</th>
                <th>Task Percentdone</th>
                <th>Task TimeNeeded</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in c)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Taskname</td>
                    <td>@item.TaskdeadLine.ToShortDateString()</td>
                    <td>@item.TaskperentCompeleted</td>
                    <td>@item.Tasktimeneeded</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {

    protected override async System.Threading.Tasks.Task OnInitializedAsync()
    {
        TasksSync = new SynchronizedCollection<Todo.Task>(@"http://localhost:5000", "crud");
        c = new ObservableCollection<Todo.Task>();
        TasksSync.refreshTask = InvokeAsync(StateHasChanged);

        TasksSync.StartConnectionBlazorWASM();
        await System.Threading.Tasks.Task.Delay(800);
    }

    public void Search()
    {
        c = new ObservableCollection<Todo.Task>();
        if (choice == "id")
        {
            if (int.TryParse(request, out test))
            {
                error = "There is no error";
                foreach (var t in TasksSync.collection.Where(t => t.Id == int.Parse(request)).ToList())
                    c.Add(t);

            }
            else
                error = "You must write an integer";
        }

        else if (choice == "name")

        {
            if (request != null && request != "")
            {
                error = "There is no error";

                foreach (var t in TasksSync.collection.Where(t => t.Taskname.Contains(request)).ToList())
                    c.Add(t);

            }
            else
                error = "your Task name can not be null";

        }


        else
        {
            error = "You should choose Id or Name";
        }

        TasksSync.StopConnection();

    }

    private string choice;
    private string request;
    private string error = "There is no error";
    public int test;

    ObservableCollection<Todo.Task> c;
    public SynchronizedCollection<Todo.Task> TasksSync;

}
